[
  { "op": "registerParty", "as": "spec", "name": "京台科技项目专员", "kind": "specialist" },
  { "op": "registerParty", "as": "tSemi", "name": "晶泓半导体（台）", "kind": "taiwan-enterprise" },
  { "op": "registerParty", "as": "rIc", "name": "北京集成电路研究院", "kind": "research-institute" },
  { "op": "registerParty", "as": "sFab", "name": "亦庄智造场景方", "kind": "scenario-owner" },
  { "op": "registerParty", "as": "tBio", "name": "生医电子（台）", "kind": "taiwan-enterprise" },
  { "op": "registerParty", "as": "rMed", "name": "北京生物医学工程研究所", "kind": "research-institute" },
  { "op": "registerParty", "as": "sHosp", "name": "智慧医院场景方", "kind": "scenario-owner" },
  { "op": "registerParty", "as": "tFin", "name": "衡信金融科技（台）", "kind": "taiwan-enterprise" },
  { "op": "registerParty", "as": "sBank", "name": "城市商业银行", "kind": "scenario-owner" },
  { "op": "registerParty", "as": "tSoft", "name": "云桥软件（台）", "kind": "taiwan-enterprise" },
  { "op": "registerParty", "as": "rAi", "name": "北京智能软件研究院", "kind": "research-institute" },
  { "op": "registerParty", "as": "sLog", "name": "智慧物流场景方", "kind": "scenario-owner" },

  { "op": "addCapability", "partyId": "$tSemi", "category": "semiconductor", "title": "12 英寸功率器件工艺", "summary": "车规级 IGBT 工艺平台" },
  { "op": "addCapability", "partyId": "$tBio", "category": "bioelectronics", "title": "可穿戴生物传感芯片", "summary": "低功耗心电采集前端" },
  { "op": "addCapability", "partyId": "$tFin", "category": "financial-services", "title": "跨境清算风控引擎", "summary": "实时反欺诈规则引擎" },
  { "op": "addCapability", "partyId": "$tSoft", "category": "software-rnd", "title": "工业视觉质检软件", "summary": "缺陷检测模型与边缘部署" },
  { "op": "addResearchResource", "partyId": "$rIc", "category": "semiconductor", "title": "功率器件中试线", "summary": "月产能 500 片，可开放机时" },
  { "op": "addResearchResource", "partyId": "$rMed", "category": "bioelectronics", "title": "临床验证平台", "summary": "伦理审查与受试者队列" },
  { "op": "addResearchResource", "partyId": "$rAi", "category": "software-rnd", "title": "行业数据集与算力", "summary": "工业质检数据集 20 万张" },
  { "op": "addScenarioDemand", "partyId": "$sFab", "category": "semiconductor", "title": "功率器件国产替代验证", "summary": "产线替换验证场景" },
  { "op": "addScenarioDemand", "partyId": "$sHosp", "category": "bioelectronics", "title": "远程监护试点", "summary": "心内科出院患者随访" },
  { "op": "addScenarioDemand", "partyId": "$sBank", "category": "financial-services", "title": "跨境支付风控", "summary": "试点分行接入" },
  { "op": "addScenarioDemand", "partyId": "$sLog", "category": "software-rnd", "title": "仓储质检自动化", "summary": "三个仓库试点部署" },

  { "op": "submitDueDiligence", "subjectPartyId": "$tSemi", "submittedByPartyId": "$spec", "kind": "财务报表审计", "summary": "近三年审计报告摘要", "visibleTo": ["$spec", "$rIc"] },
  { "op": "submitDueDiligence", "subjectPartyId": "$tBio", "submittedByPartyId": "$spec", "kind": "专利清单核查", "summary": "核心专利权属无争议", "visibleTo": ["$spec", "$rMed"] },
  { "op": "submitDueDiligence", "subjectPartyId": "$tFin", "submittedByPartyId": "$sBank", "kind": "监管合规意见", "summary": "试点分行合规初审通过", "visibleTo": ["$sBank"] },

  { "op": "createProject", "as": "prj1", "title": "功率器件联合验证项目", "category": "semiconductor", "partyIds": ["$tSemi", "$rIc", "$sFab"] },
  { "op": "draftIntent", "as": "i1", "projectId": "$prj1", "commitments": [
    { "stage": "engagement", "responsiblePartyId": "$tSemi", "scope": "三方技术团队完成需求对齐", "preconditions": ["签署保密协议"], "evidenceRequirements": ["会议纪要"] },
    { "stage": "signing", "responsiblePartyId": "$tSemi", "scope": "三方签署联合验证协议", "preconditions": ["意向确认完整", "尽调材料齐备"], "evidenceRequirements": ["合同文本"] },
    { "stage": "resource-investment", "responsiblePartyId": "$rIc", "scope": "开放功率器件中试线机时 200 小时", "preconditions": ["协议生效"], "evidenceRequirements": ["机时记录"] }
  ] },
  { "op": "confirmIntent", "intentId": "$i1", "partyId": "$tSemi", "version": 1 },
  { "op": "confirmIntent", "intentId": "$i1", "partyId": "$rIc", "version": 1 },
  { "op": "confirmIntent", "intentId": "$i1", "partyId": "$sFab", "version": 1 },
  { "op": "startExecution", "intentId": "$i1" },
  { "op": "createContractVersion", "as": "ct1", "projectId": "$prj1", "byPartyId": "$tSemi", "terms": "功率器件联合验证协议 v1", "affects": [] },
  { "op": "activateContract", "contractId": "$ct1", "expectedValidVersion": null },
  { "op": "submitEvidence", "as": "e1", "projectId": "$prj1", "commitmentId": "$i1.commitmentIds.0", "kind": "会议纪要", "summary": "首轮需求对齐纪要", "submittedByPartyId": "$tSemi" },
  { "op": "fulfillCommitment", "commitmentId": "$i1.commitmentIds.0", "byPartyId": "$tSemi", "evidenceIds": ["$e1"] },
  { "op": "submitEvidence", "as": "e2", "projectId": "$prj1", "commitmentId": "$i1.commitmentIds.1", "kind": "合同文本", "summary": "三方签署版协议扫描件", "submittedByPartyId": "$tSemi" },
  { "op": "fulfillCommitment", "commitmentId": "$i1.commitmentIds.1", "byPartyId": "$tSemi", "evidenceIds": ["$e2"] },
  { "op": "addMilestone", "projectId": "$prj1", "stage": "resource-investment", "title": "首批流片完成", "dueDate": "2026-11-30" },

  { "op": "createProject", "as": "prj2", "title": "远程监护生物传感验证", "category": "bioelectronics", "partyIds": ["$tBio", "$rMed", "$sHosp"] },
  { "op": "draftIntent", "as": "i2", "projectId": "$prj2", "commitments": [
    { "stage": "engagement", "responsiblePartyId": "$tBio", "scope": "完成远程监护需求对接", "preconditions": ["签署保密协议"], "evidenceRequirements": ["会议纪要"] },
    { "stage": "signing", "responsiblePartyId": "$tBio", "scope": "签署生物传感联合验证协议", "preconditions": ["伦理审查通过"], "evidenceRequirements": ["合同文本"] },
    { "stage": "resource-investment", "responsiblePartyId": "$rMed", "scope": "投入临床验证平台与受试者队列", "preconditions": ["协议生效"], "evidenceRequirements": ["设备到位单"] },
    { "stage": "verification", "responsiblePartyId": "$sHosp", "scope": "完成 90 天院内远程监护验证", "preconditions": ["设备到位"], "evidenceRequirements": ["验证报告"] },
    { "stage": "order", "responsiblePartyId": "$sHosp", "scope": "形成首批采购订单", "preconditions": ["验证达标"], "evidenceRequirements": ["订单合同"] }
  ] },
  { "op": "confirmIntent", "intentId": "$i2", "partyId": "$tBio", "version": 1 },
  { "op": "confirmIntent", "intentId": "$i2", "partyId": "$rMed", "version": 1 },
  { "op": "confirmIntent", "intentId": "$i2", "partyId": "$sHosp", "version": 1 },
  { "op": "startExecution", "intentId": "$i2" },
  { "op": "createContractVersion", "as": "ct2", "projectId": "$prj2", "byPartyId": "$tBio", "terms": "生物传感联合验证协议 v1", "affects": [] },
  { "op": "activateContract", "contractId": "$ct2", "expectedValidVersion": null },
  { "op": "submitEvidence", "as": "e3", "projectId": "$prj2", "commitmentId": "$i2.commitmentIds.0", "kind": "会议纪要", "summary": "需求对接纪要", "submittedByPartyId": "$tBio" },
  { "op": "fulfillCommitment", "commitmentId": "$i2.commitmentIds.0", "byPartyId": "$tBio", "evidenceIds": ["$e3"] },
  { "op": "submitEvidence", "as": "e4", "projectId": "$prj2", "commitmentId": "$i2.commitmentIds.1", "kind": "合同文本", "summary": "联合验证协议签署版", "submittedByPartyId": "$tBio" },
  { "op": "fulfillCommitment", "commitmentId": "$i2.commitmentIds.1", "byPartyId": "$tBio", "evidenceIds": ["$e4"] },
  { "op": "submitEvidence", "as": "e5", "projectId": "$prj2", "commitmentId": "$i2.commitmentIds.2", "kind": "设备到位单", "summary": "验证设备签收记录", "submittedByPartyId": "$rMed" },
  { "op": "fulfillCommitment", "commitmentId": "$i2.commitmentIds.2", "byPartyId": "$rMed", "evidenceIds": ["$e5"] },
  { "op": "submitEvidence", "as": "e6", "projectId": "$prj2", "commitmentId": "$i2.commitmentIds.3", "kind": "验证报告", "summary": "90 天临床数据摘要", "hash": "sha256:demo-bio-verify", "submittedByPartyId": "$sHosp", "classification": "restricted", "visibleTo": ["$tBio", "$sHosp"] },
  { "op": "fulfillCommitment", "commitmentId": "$i2.commitmentIds.3", "byPartyId": "$sHosp", "evidenceIds": ["$e6"] },
  { "op": "addMilestone", "as": "m2", "projectId": "$prj2", "stage": "verification", "title": "临床验证完成", "commitmentId": "$i2.commitmentIds.3" },
  { "op": "completeMilestone", "milestoneId": "$m2", "byPartyId": "$sHosp", "evidenceIds": ["$e6"] },

  { "op": "createProject", "as": "prj3", "title": "跨境支付风控试点", "category": "financial-services", "partyIds": ["$tFin", "$sBank"] },
  { "op": "draftIntent", "as": "i3v1", "projectId": "$prj3", "commitments": [
    { "stage": "engagement", "responsiblePartyId": "$tFin", "scope": "完成风控需求对接", "preconditions": ["签署保密协议"], "evidenceRequirements": ["会议纪要"] },
    { "stage": "signing", "responsiblePartyId": "$tFin", "scope": "签署试点合作协议", "preconditions": ["合规初审通过"], "evidenceRequirements": ["合同文本"] }
  ] },
  { "op": "confirmIntent", "intentId": "$i3v1", "partyId": "$tFin", "version": 1 },
  { "op": "withdrawIntent", "intentId": "$i3v1", "byPartyId": "$sBank", "reason": "监管口径调整，条款重议" },
  { "op": "draftIntent", "as": "i3", "projectId": "$prj3", "commitments": [
    { "stage": "engagement", "responsiblePartyId": "$tFin", "scope": "按新监管口径完成需求对接", "preconditions": ["签署保密协议"], "evidenceRequirements": ["会议纪要"] },
    { "stage": "signing", "responsiblePartyId": "$tFin", "scope": "签署试点合作协议（修订版）", "preconditions": ["合规复审通过"], "evidenceRequirements": ["合同文本"] }
  ] },
  { "op": "confirmIntent", "intentId": "$i3", "partyId": "$tFin", "version": 1 },
  { "op": "confirmIntent", "intentId": "$i3", "partyId": "$sBank", "version": 1 },
  { "op": "startExecution", "intentId": "$i3" },
  { "op": "submitEvidence", "as": "e7", "projectId": "$prj3", "commitmentId": "$i3.commitmentIds.0", "kind": "会议纪要", "summary": "新口径需求对接纪要", "submittedByPartyId": "$tFin" },
  { "op": "fulfillCommitment", "commitmentId": "$i3.commitmentIds.0", "byPartyId": "$tFin", "evidenceIds": ["$e7"] },

  { "op": "createProject", "as": "prj4", "title": "仓储视觉质检联合研发", "category": "software-rnd", "partyIds": ["$tSoft", "$rAi", "$sLog"] },
  { "op": "draftIntent", "as": "i4", "projectId": "$prj4", "commitments": [
    { "stage": "engagement", "responsiblePartyId": "$tSoft", "scope": "完成仓储质检需求对接", "preconditions": ["签署保密协议"], "evidenceRequirements": ["会议纪要"] },
    { "stage": "signing", "responsiblePartyId": "$tSoft", "scope": "签署联合研发协议", "preconditions": ["意向确认完整"], "evidenceRequirements": ["合同文本"] },
    { "stage": "resource-investment", "responsiblePartyId": "$rAi", "scope": "开通质检数据集与训练算力", "preconditions": ["协议生效"], "evidenceRequirements": ["算力开通记录"] },
    { "stage": "verification", "responsiblePartyId": "$sLog", "scope": "三仓库试点验收", "preconditions": ["模型部署完成"], "evidenceRequirements": ["验收报告"] },
    { "stage": "order", "responsiblePartyId": "$sLog", "scope": "形成年度软件采购订单", "preconditions": ["验收达标"], "evidenceRequirements": ["订单合同"] },
    { "stage": "verification", "responsiblePartyId": "$rAi", "scope": "开源组件合规审计", "preconditions": ["代码冻结"], "evidenceRequirements": ["审计报告"] }
  ] },
  { "op": "confirmIntent", "intentId": "$i4", "partyId": "$tSoft", "version": 1 },
  { "op": "confirmIntent", "intentId": "$i4", "partyId": "$rAi", "version": 1 },
  { "op": "confirmIntent", "intentId": "$i4", "partyId": "$sLog", "version": 1 },
  { "op": "startExecution", "intentId": "$i4" },
  { "op": "createContractVersion", "as": "ct4a", "projectId": "$prj4", "byPartyId": "$tSoft", "terms": "联合研发协议 v1", "affects": [] },
  { "op": "activateContract", "contractId": "$ct4a", "expectedValidVersion": null },
  { "op": "submitEvidence", "as": "e8", "projectId": "$prj4", "commitmentId": "$i4.commitmentIds.0", "kind": "会议纪要", "summary": "需求对接纪要", "submittedByPartyId": "$tSoft" },
  { "op": "fulfillCommitment", "commitmentId": "$i4.commitmentIds.0", "byPartyId": "$tSoft", "evidenceIds": ["$e8"] },
  { "op": "submitEvidence", "as": "e9", "projectId": "$prj4", "commitmentId": "$i4.commitmentIds.1", "kind": "合同文本", "summary": "联合研发协议签署版", "submittedByPartyId": "$tSoft" },
  { "op": "fulfillCommitment", "commitmentId": "$i4.commitmentIds.1", "byPartyId": "$tSoft", "evidenceIds": ["$e9"] },
  { "op": "submitEvidence", "as": "e10", "projectId": "$prj4", "commitmentId": "$i4.commitmentIds.2", "kind": "算力开通记录", "summary": "训练集群开通工单", "submittedByPartyId": "$rAi" },
  { "op": "fulfillCommitment", "commitmentId": "$i4.commitmentIds.2", "byPartyId": "$rAi", "evidenceIds": ["$e10"] },
  { "op": "submitEvidence", "as": "e11", "projectId": "$prj4", "commitmentId": "$i4.commitmentIds.3", "kind": "验收报告", "summary": "三仓库试点验收结论", "submittedByPartyId": "$sLog" },
  { "op": "fulfillCommitment", "commitmentId": "$i4.commitmentIds.3", "byPartyId": "$sLog", "evidenceIds": ["$e11"] },
  { "op": "submitEvidence", "as": "e12", "projectId": "$prj4", "commitmentId": "$i4.commitmentIds.4", "kind": "订单合同", "summary": "年度采购订单扫描件", "submittedByPartyId": "$sLog", "classification": "restricted", "visibleTo": ["$tSoft", "$sLog"] },
  { "op": "fulfillCommitment", "commitmentId": "$i4.commitmentIds.4", "byPartyId": "$sLog", "evidenceIds": ["$e12"] },
  { "op": "createContractVersion", "as": "ct4b", "projectId": "$prj4", "byPartyId": "$tSoft", "terms": "补充协议：合规审计改由第三方机构执行", "affects": ["$i4.commitmentIds.5"] },
  { "op": "activateContract", "contractId": "$ct4b", "expectedValidVersion": 1 },
  { "op": "addMilestone", "as": "m4", "projectId": "$prj4", "stage": "order", "title": "首单交付", "commitmentId": "$i4.commitmentIds.4" },
  { "op": "completeMilestone", "milestoneId": "$m4", "byPartyId": "$sLog", "evidenceIds": ["$e12"] }
]
